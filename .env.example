# 复制成 .env 并按需修改；代码只读环境变量，绝不把密钥写进仓库
FCL_PROVIDER=mock
FCL_LLM_BASE_URL=https://api.deepseek.com/v1
FCL_LLM_API_KEY=
FCL_LLM_MODEL=deepseek-chat

FCL_WORKER_CONCURRENCY=4
FCL_RATE_LIMIT_PER_MIN=120
FCL_RATE_LIMIT_BURST=20

FCL_CACHE_TTL_S=3600
FCL_CACHE_MAX_ITEMS=2000

FCL_PASS_THRESHOLD=78
FCL_MAX_REWRITE_ROUNDS=1

FCL_DB_URL=sqlite:///./data/fcl.db
FCL_REDIS_URL=
